{
  // Cloudflare Worker manifest. See `AGENTS.md` for what each field
  // drives (R2 binding, assets, vars) and how
  // the verifier consumes the vars.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minimal-cloudflare",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-10-23",
  // `enable_request_signal` lets `/v1/since` see client disconnects. It is the
  // default from compatibility_date 2026-11-17; drop it when the date moves past that.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "minimal-cloudflare",
    },
  ],

  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
  },

  "vars": {
    "APP": "minimal-cloudflare",
    "TENANT": "minimal-demo",
  },
}
