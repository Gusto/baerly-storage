{
  "name": "minimal-cloudflare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@gusto/baerly-storage": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.22.0"
}
